{
  "name": "dsh-plugin-middle-panel",
  "version": "0.3.0",
  "description": "Middle canvas panel for DeepSeek Harness: shows deliverables between the workspace list and the conversation, and sends numbered annotations back to the chat.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "canvas",
    "annotation",
    "viewer",
    "markdown",
    "3d",
    "review"
  ],
  "license": "MIT",
  "author": "Darkhe55",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darkhe55/dsh-plugin-middle-panel.git"
  },
  "homepage": "https://github.com/Darkhe55/dsh-plugin-middle-panel#readme",
  "bugs": {
    "url": "https://github.com/Darkhe55/dsh-plugin-middle-panel/issues"
  },
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "readme": "README.en.md",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node scripts/build.cjs && node test/markdown.test.cjs && node test/diff.test.cjs && node test/collada.test.cjs && node test/relocate.test.cjs && node test/conflict.test.cjs && node test/smoke.test.cjs && node test/panel-render.test.cjs",
    "build": "node scripts/build.cjs",
    "prepublishOnly": "node scripts/build.cjs"
  }
}
